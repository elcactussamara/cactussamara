---
const year = new Date().getFullYear();

const hours = [
  { day: 'Monday', time: '08:00 – 16:30' },
  { day: 'Tuesday', time: '08:00 – 16:30' },
  { day: 'Wednesday', time: '08:00 – 16:30' },
  { day: 'Thursday', time: '08:00 – 16:30' },
  { day: 'Friday', time: '08:00 – 16:30' },
  { day: 'Saturday', time: '08:00 – 16:30' },
  { day: 'Sunday', time: 'Closed' },
];

const navLinks = [
  { label: 'Home', href: '#top' },
  { label: 'Services', href: '#services' },
  { label: 'Availability', href: '#booking' },
  { label: 'Find Us', href: '#contact' },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <!-- Address & contact -->
      <div class="footer__col">
        <div class="footer__group">
          <h4 class="footer__label">Address</h4>
          <p class="footer__text">
            100 meters west of the National Bank, C. Diego,<br />
            Guanacaste Province, Sámara, 50205
          </p>
        </div>
        <div class="footer__group">
          <h4 class="footer__label">Contact</h4>
          <p class="footer__text">
            <a href="tel:+50683896565">83 89 65 65</a><br />
            <a href="mailto:elcactussamara2022@gmail.com">elcactussamara2022@gmail.com</a><br />
            <a href="https://wa.me/50683896565" target="_blank" rel="noopener">Chat on WhatsApp</a>
          </p>
        </div>
        <div class="footer__social">
          <a href="https://www.facebook.com/people/El-Cactus-Services/61585553481709/" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.45 2.9h-2.35v7A10 10 0 0022 12z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/elcactus_rental_samara/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Opening hours -->
      <div class="footer__col">
        <h4 class="footer__label">Opening Hours</h4>
        <ul class="footer__hours">
          {hours.map((h) => (
            <li>
              <span class="footer__day">{h.day}</span>
              <span class="footer__time">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Nav -->
      <nav class="footer__nav">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>

    <div class="footer__logo">
      <img src="/logos/cactus-wordmark.webp" alt="Cactus" width="968" height="238" loading="lazy" decoding="async" />
    </div>

    <div class="footer__credits">
      <p>
        © {year} Cactus. All rights reserved. Developed by
        <a href="https://webdiiv.com" target="_blank" rel="noopener" class="footer__dev">Webdiiv</a>
      </p>
      <div class="footer__legal">
        <a href="#">Privacy</a>
        <a href="#">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-cream);
    padding: 80px 64px 40px;
  }
  .footer__inner {
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .footer__label {
    font-family: var(--font-display);
    font-size: var(--fs-14);
    color: var(--color-black);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .footer__group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer__text {
    font-family: var(--font-ui);
    font-size: var(--fs-14);
    color: var(--color-black);
    line-height: 1.6;
  }
  .footer__text a {
    transition: color 0.15s ease;
  }
  .footer__text a:hover {
    color: var(--color-orange);
  }

  .footer__social {
    display: flex;
    gap: 12px;
    margin-top: 4px;
    color: var(--color-black);
  }
  .footer__social a {
    transition: color 0.15s ease;
  }
  .footer__social a:hover {
    color: var(--color-orange);
  }

  .footer__hours {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .footer__hours li {
    display: flex;
    gap: 24px;
    font-family: var(--font-ui);
    font-size: var(--fs-14);
    color: var(--color-black);
  }
  .footer__day {
    width: 92px;
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
    font-family: var(--font-display);
    font-size: var(--fs-16);
    color: var(--color-black);
  }
  .footer__nav a {
    text-transform: uppercase;
    transition: color 0.15s ease;
  }
  .footer__nav a:hover {
    color: var(--color-orange);
  }

  .footer__logo {
    display: flex;
    justify-content: center;
  }
  .footer__logo img {
    width: 100%;
    max-width: 968px;
    height: auto;
  }

  .footer__credits {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-family: var(--font-ui);
    font-size: var(--fs-14);
    color: var(--color-black);
  }
  .footer__legal {
    display: flex;
    gap: 24px;
  }
  .footer__legal a:hover,
  .footer__dev:hover {
    color: var(--color-orange);
  }
  .footer__dev {
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  @media (max-width: 900px) {
    .footer {
      padding: 48px 20px 32px;
    }
    .footer__inner {
      gap: 32px;
    }
    .footer__top {
      flex-direction: column;
      gap: 32px;
    }
    .footer__nav {
      align-items: flex-start;
    }
    .footer__credits {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

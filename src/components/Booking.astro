<!-- Cases du calendrier générées en JS : hors de portée des styles scoped d'Astro. -->
<style is:global>
  .calendar .cal-day {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-sand);
    border: 0;
    border-right: 1px solid var(--color-sand-line);
    border-bottom: 1px solid var(--color-sand-line);
    font-family: var(--font-roboto);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-black);
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .calendar .cal-day:not(:disabled):hover {
    background: var(--color-sand-line);
  }
  .calendar .cal-day:disabled {
    color: rgba(0, 0, 0, 0.28);
    cursor: not-allowed;
  }
  .calendar .cal-day--in-range {
    background: #f6dcc8;
  }
  .calendar .cal-day--selected,
  .calendar .cal-day--selected:not(:disabled):hover {
    background: var(--color-orange);
    color: var(--color-cream);
  }
  .calendar .cal-day:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: -2px;
  }
  /* Coins de la grille arrondis à 12px : même rayon que la photo de la card
     "Experience Overview", placée dans le même cas (card r24 + marge ≥ 24px, où la
     formule rayon interne = rayon externe − marge donnerait ≤ 0). La grille ne contient
     que les cases → 7e = fin de la 1re ligne, 7e avant-dernière = début de la dernière. */
  .calendar .cal-day:first-child {
    border-top-left-radius: 12px;
  }
  .calendar .cal-day:nth-child(7) {
    border-top-right-radius: 12px;
  }
  .calendar .cal-day:nth-last-child(7) {
    border-bottom-left-radius: 12px;
  }
  .calendar .cal-day:last-child {
    border-bottom-right-radius: 12px;
  }
  .calendar--popover .cal-day {
    height: 40px;
  }
  @media (max-width: 900px) {
    .calendar--popover .cal-day {
      height: 36px;
    }
  }
</style>

<script>
  type Kind = 'tour' | 'rental';
  type ApiResult = { ok: boolean; mock?: boolean; error?: string; code?: string; [k: string]: unknown };

  /** WhatsApp de l'agence : les demandes d'ATV Tour (hors Worco) y sont envoyées. */
  const CACTUS_WHATSAPP = '50683896565';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLElement>('.booking').forEach((root) => {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    // Textes dans la langue de la page (src/i18n/ui.ts → booking.js)
    const T = JSON.parse(root.dataset.i18n || '{}');
    const fill = (text: string, vars: Record<string, string | number>) =>
      text.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

    const tabs = root.querySelectorAll<HTMLButtonElement>('.cat-tab');
    const panels = root.querySelectorAll<HTMLElement>('[data-cat-panel]');
    const expCard = $<HTMLElement>('[data-exp-card]');
    const overviewText = $<HTMLElement>('[data-overview-text]');
    const catInput = $<HTMLInputElement>('[data-cat-input]');
    const groups = root.querySelectorAll<HTMLFieldSetElement>('fieldset[data-kind]');
    const vehicleHint = $<HTMLElement>('[data-hint-slot]');

    const grid = $<HTMLElement>('[data-cal-grid]');
    const monthLabel = $<HTMLElement>('[data-cal-month]');
    const prevBtn = $<HTMLButtonElement>('[data-cal-prev]');
    const nextBtn = $<HTMLButtonElement>('[data-cal-next]');
    const dateSingle = $<HTMLInputElement>('[data-date-single]');
    const dateStart = $<HTMLInputElement>('[data-date-start]');
    const dateEnd = $<HTMLInputElement>('[data-date-end]');

    const form = $<HTMLFormElement>('[data-booking-form]');
    const pill = $<HTMLElement>('[data-price-pill]');
    const pricePrefix = $<HTMLElement>('[data-price-prefix]');
    const priceAmount = $<HTMLElement>('[data-price-amount]');
    const priceSuffix = $<HTMLElement>('[data-price-suffix]');
    const submitBtn = $<HTMLButtonElement>('.bform__submit');
    const msg = $<HTMLElement>('[data-msg]');
    if (!grid || !monthLabel || !form || !msg) return;

    let kind: Kind = (tabs[0]?.dataset.kind as Kind) || 'tour';
    /** Site en ligne sans Worco : locations sans prix, envoyées par WhatsApp (attribut posé au build). */
    const rentalsViaWhatsApp = () => root.dataset.rentals === 'whatsapp';
    const field = <T extends HTMLElement = HTMLInputElement>(name: string) => form.querySelector<T>(`[name="${name}"]`);

    /* ---------- Messages ---------- */
    // `source` distingue un avertissement de disponibilité (effacé quand ça redevient bon)
    // d'un message d'envoi (conservé).
    function showMsg(text: string, type: 'error' | 'success', source: 'quote' | 'submit' = 'submit', link?: { href: string; label: string }) {
      msg!.textContent = text;
      if (link) {
        const a = document.createElement('a');
        a.href = link.href;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = link.label;
        a.style.textDecoration = 'underline';
        msg!.append(' ', a);
      }
      msg!.classList.toggle('is-error', type === 'error');
      msg!.dataset.source = source;
      msg!.hidden = false;
    }
    function clearMsg(source?: 'quote' | 'submit') {
      if (!source || msg!.dataset.source === source) msg!.hidden = true;
    }

    /* ---------- Calendar ---------- */
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const firstMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    let view = new Date(firstMonth);
    const sel: { start: Date | null; end: Date | null } = { start: null, end: null };

    const dateFmt = new Intl.DateTimeFormat(T.intl, { day: '2-digit', month: 'short', year: 'numeric' });
    const monthFmt = new Intl.DateTimeFormat(T.intl, { month: 'long', year: 'numeric' });
    const fmt = (d: Date) => dateFmt.format(d);
    const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const same = (a: Date | null, b: Date) => !!a && a.getTime() === b.getTime();

    function render() {
      const year = view.getFullYear();
      const month = view.getMonth();
      const label = monthFmt.format(view);
      monthLabel!.textContent = label.charAt(0).toUpperCase() + label.slice(1);
      if (prevBtn) prevBtn.disabled = view <= firstMonth;

      const offset = (new Date(year, month, 1).getDay() + 6) % 7; // lundi = 0
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const cells = Math.ceil((offset + daysInMonth) / 7) * 7;

      grid!.innerHTML = '';
      for (let i = 0; i < cells; i++) {
        const d = new Date(year, month, 1 - offset + i);
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'cal-day';
        cell.textContent = String(d.getDate());
        cell.setAttribute('aria-label', fmt(d));
        if (d < today) cell.disabled = true;
        const selected = same(sel.start, d) || same(sel.end, d);
        if (selected) cell.classList.add('cal-day--selected');
        cell.setAttribute('aria-pressed', String(selected));
        if (sel.start && sel.end && d > sel.start && d < sel.end) cell.classList.add('cal-day--in-range');
        cell.addEventListener('click', (e) => pick(d, e.detail === 0));
        grid!.appendChild(cell);
      }
    }

    function syncDateFields() {
      if (dateSingle) dateSingle.value = sel.start ? fmt(sel.start) : '';
      if (dateStart) dateStart.value = sel.start ? fmt(sel.start) : '';
      if (dateEnd) dateEnd.value = sel.end ? fmt(sel.end) : '';
    }

    /* ---------- Calendrier pop-up ---------- */
    type DateField = 'single' | 'start' | 'end';
    const popover = $<HTMLElement>('[data-calendar]');
    const hint = $<HTMLElement>('[data-cal-hint]');
    const dateInputs: Record<DateField, HTMLInputElement | null> = { single: dateSingle, start: dateStart, end: dateEnd };
    const HINTS: Record<DateField, string> = { single: T.hintSingle, start: T.hintStart, end: T.hintEnd };
    let active: DateField | null = null;
    const monthOf = (d: Date) => new Date(d.getFullYear(), d.getMonth(), 1);

    function setActive(field: DateField) {
      active = field;
      if (hint) hint.textContent = HINTS[field];
      (Object.keys(dateInputs) as DateField[]).forEach((k) => dateInputs[k]?.setAttribute('aria-expanded', String(k === field)));
    }

    /** Sous le champ actif, calé dans la largeur du formulaire. */
    function positionPicker() {
      if (!popover || !active) return;
      const input = dateInputs[active];
      if (!input) return;
      const fr = form!.getBoundingClientRect();
      const ir = input.getBoundingClientRect();
      const cs = getComputedStyle(form!);
      const inset = parseFloat(cs.paddingLeft) + parseFloat(cs.borderLeftWidth);
      const width = Math.min(360, fr.width - 2 * inset);
      const left = Math.min(Math.max(ir.left - fr.left, inset), fr.width - inset - width);
      popover.style.width = `${width}px`;
      popover.style.left = `${left}px`;
      popover.style.top = `${ir.bottom - fr.top + 8}px`;
    }

    function focusDayCell() {
      (grid!.querySelector<HTMLButtonElement>('.cal-day--selected:not(:disabled)') || grid!.querySelector<HTMLButtonElement>('.cal-day:not(:disabled)'))?.focus();
    }

    function openPicker(field: DateField, viaKeyboard = false) {
      if (!popover) return;
      if (field === 'end' && !sel.start) field = 'start'; // d'abord le départ
      setActive(field);
      const ref = field === 'end' ? (sel.end ?? sel.start) : sel.start;
      view = ref ? monthOf(ref) : new Date(firstMonth);
      if (view < firstMonth) view = new Date(firstMonth);
      popover.hidden = false;
      render();
      positionPicker();
      if (viaKeyboard) focusDayCell();
    }

    function closePicker(returnFocus = false) {
      if (!popover || popover.hidden) return;
      const input = active ? dateInputs[active] : null;
      popover.hidden = true;
      active = null;
      Object.values(dateInputs).forEach((el) => el?.setAttribute('aria-expanded', 'false'));
      if (returnFocus) input?.focus();
    }

    function pick(d: Date, viaKeyboard = false) {
      // Tour : une seule date
      if (kind === 'tour' || active === 'single') {
        sel.start = d;
        sel.end = null;
        syncDateFields();
        closePicker(viaKeyboard);
        updatePrice();
        return;
      }
      // Location — date de départ : on enchaîne sur la date de retour (sauf si elle reste valable)
      if (active === 'start' || !sel.start) {
        sel.start = d;
        const endStillValid = !!sel.end && sel.end >= d;
        if (!endStillValid) sel.end = null;
        syncDateFields();
        updatePrice();
        if (endStillValid) return closePicker(viaKeyboard);
        setActive('end');
        render();
        positionPicker();
        if (viaKeyboard) focusDayCell();
        return;
      }
      // Location — date de retour (même jour possible : location à la journée)
      if (d < sel.start) {
        sel.start = d; // clic avant le départ : devient le nouveau départ, on attend toujours le retour
        sel.end = null;
        syncDateFields();
        render();
        updatePrice();
        if (viaKeyboard) focusDayCell();
        return;
      }
      sel.end = d;
      syncDateFields();
      closePicker(viaKeyboard);
      updatePrice();
    }

    prevBtn?.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      render();
    });
    nextBtn?.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      render();
    });

    // Ouverture : clic sur un champ date (au clavier : Entrée / Espace / ↓, gérés plus bas)
    (Object.keys(dateInputs) as DateField[]).forEach((k) => dateInputs[k]?.addEventListener('click', () => openPicker(k)));
    // Fermeture : clic à côté, Échap, ou focus qui sort du calendrier (navigation au clavier)
    document.addEventListener('pointerdown', (e) => {
      if (!active) return;
      const t = e.target as Node;
      if (popover!.contains(t) || Object.values(dateInputs).includes(t as HTMLInputElement)) return;
      closePicker();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && active) {
        e.preventDefault();
        closePicker(true);
      }
    });
    popover?.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !popover.contains(next) && !Object.values(dateInputs).includes(next as HTMLInputElement)) closePicker();
    });
    window.addEventListener('resize', positionPicker);

    /* ---------- Price pill ---------- */
    function setPill(prefix: string, amount: string, suffix: string | null, loading = false) {
      if (!pill || !priceAmount || !pricePrefix || !priceSuffix) return;
      pricePrefix.textContent = prefix;
      priceAmount.textContent = amount;
      priceSuffix.textContent = suffix ?? '';
      priceSuffix.hidden = !suffix;
      pill.classList.toggle('is-loading', loading);
      pill.hidden = false;
    }
    const hidePill = () => pill && (pill.hidden = true);

    // --- Tour : prix de la grille affichée (hors Worco) ---
    function tourTotal() {
      const tour = form!.querySelector<HTMLInputElement>('input[name="tour"]:checked');
      const riders = field<HTMLSelectElement>('ridersPerQuad')?.value || '1';
      const quads = Math.max(1, parseInt(field('quads')?.value || '1', 10) || 1);
      return Number(tour?.getAttribute(`data-price-${riders}`) || 0) * quads;
    }

    // --- Locations : prix Worco via /api/quote ---
    const fromCache = new Map<string, { from: number | null; currencySymbol: string }>();
    let quoteTimer: number | undefined;
    let quoteSeq = 0; // ignore les réponses arrivées après une réponse plus récente
    let lastQuoteKey = '';

    function rentalParams() {
      return new URLSearchParams({
        category: catInput?.value || '',
        startDate: sel.start ? iso(sel.start) : '',
        endDate: sel.end ? iso(sel.end) : '',
        pickupTime: field<HTMLSelectElement>('pickupTime')?.value || '08:00',
        vehicles: String(Math.max(1, parseInt(field('vehicles')?.value || '1', 10) || 1)),
      });
    }

    async function refreshRentalPrice() {
      const seq = ++quoteSeq;
      const params = rentalParams();
      const category = params.get('category')!;

      // Sans dates : prix d'appel « from X$ / day »
      if (!sel.start || !sel.end) {
        clearMsg('quote');
        lastQuoteKey = '';
        let cached = fromCache.get(category);
        if (!cached) {
          setPill(T.from, '…', T.perDay, true);
          try {
            const res: ApiResult = await fetch(`/api/quote?category=${encodeURIComponent(category)}`).then((r) => r.json());
            if (!res.ok) throw new Error(res.error);
            cached = { from: res.from as number | null, currencySymbol: String(res.currencySymbol || '$') };
            fromCache.set(category, cached);
          } catch {
            if (seq === quoteSeq) hidePill();
            return;
          }
        }
        if (seq !== quoteSeq) return;
        if (cached.from == null) hidePill();
        else setPill(T.from, `${cached.from}${cached.currencySymbol}`, T.perDay);
        return;
      }

      // Avec dates : total réel pour N véhicules (tarifs saisonniers Worco)
      const key = params.toString();
      if (key === lastQuoteKey) return;
      setPill(T.total, '…', null, true);
      try {
        const res: ApiResult = await fetch(`/api/quote?${params}`).then((r) => r.json());
        if (seq !== quoteSeq) return;
        if (!res.ok) {
          hidePill();
          showMsg(T.priceUnavailable, 'error', 'quote');
          return;
        }
        lastQuoteKey = key;
        if (!res.enough) {
          hidePill();
          const n = Number(res.available);
          const [one, many] = vehicleLabel();
          showMsg(fill(n === 0 ? T.none : n === 1 ? T.onlyOne : T.onlyMany, { n, one, many }), 'error', 'quote');
          return;
        }
        clearMsg('quote');
        setPill(T.total, `${res.total}${res.currencySymbol || '$'}`, null);
      } catch {
        if (seq === quoteSeq) hidePill();
      }
    }

    /** [singulier, pluriel] du véhicule de l'onglet actif, dans la langue de la page. */
    function vehicleLabel(): [string, string] {
      return T.vehicles[catInput?.value || ''] || T.vehicles.default;
    }

    function updatePrice() {
      if (kind === 'tour') {
        window.clearTimeout(quoteTimer);
        quoteSeq++; // annule une requête de location en cours
        const total = tourTotal();
        total ? setPill(T.total, `${total}$`, null) : hidePill();
        return;
      }
      if (rentalsViaWhatsApp()) {
        hidePill(); // pas de prix sans Worco (on n'affiche jamais de prix inventés)
        return;
      }
      // Locations : attendre 400 ms sans changement (limite Worco : 120 requêtes/min)
      window.clearTimeout(quoteTimer);
      quoteTimer = window.setTimeout(refreshRentalPrice, 400);
    }

    // Recalcul uniquement pour les champs qui influent sur le prix (pas en tapant son nom)
    const PRICE_FIELDS = ['tour', 'quads', 'ridersPerQuad', 'pickupTime', 'vehicles'];
    const onPriceField = (e: Event) => {
      const t = e.target as HTMLInputElement;
      if (PRICE_FIELDS.includes(t.name)) updatePrice();
      if (t.getAttribute?.('aria-invalid')) t.removeAttribute('aria-invalid');
    };
    form.addEventListener('input', onPriceField);
    form.addEventListener('change', onPriceField);

    /* ---------- Champs : Entrée valide le champ, n'envoie PAS la demande ---------- */
    // Garde un nombre valide (min 1, pas de maximum) : "0" ou "" → 1
    function normalizeNumber(input: HTMLInputElement) {
      const min = Number(input.min || 1);
      const max = Number(input.max || Infinity);
      const n = parseInt(input.value, 10);
      input.value = String(Number.isNaN(n) ? min : Math.min(max, Math.max(min, n)));
    }
    form.addEventListener('change', (e) => {
      const t = e.target;
      if (t instanceof HTMLInputElement && t.type === 'number') {
        normalizeNumber(t);
        updatePrice();
      }
    });
    // Par défaut, Entrée dans un champ soumet le formulaire : on l'empêche.
    // La demande ne part qu'au clic sur « Request reservation ». (Le textarea garde Entrée = retour à la ligne.)
    form.addEventListener('keydown', (e) => {
      const t = e.target;
      if (t instanceof HTMLInputElement && t.dataset.dateField && ['Enter', ' ', 'ArrowDown'].includes(e.key)) {
        e.preventDefault();
        openPicker(t.dataset.dateField as DateField, true);
        return;
      }
      if (e.key !== 'Enter' || !(t instanceof HTMLInputElement || t instanceof HTMLSelectElement)) return;
      e.preventDefault();
      if (t instanceof HTMLInputElement && t.type === 'radio') {
        t.click(); // Entrée sur une carte de tour = la sélectionner
        return;
      }
      if (t instanceof HTMLInputElement && t.type === 'number') normalizeNumber(t);
      updatePrice();
      t.blur(); // « valide » le champ (sort de l'édition)
    });

    /* ---------- Category tabs ---------- */
    function setCategory(tab: HTMLButtonElement) {
      const id = tab.dataset.cat || '';
      kind = (tab.dataset.kind as Kind) || 'rental';

      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      panels.forEach((p) => (p.hidden = p.dataset.catPanel !== id));
      expCard?.classList.toggle('exp-card--center', kind === 'rental');
      if (overviewText) overviewText.textContent = tab.dataset.overview || '';
      if (catInput) catInput.value = id;
      if (vehicleHint) vehicleHint.textContent = tab.dataset.vehicleHint || '';
      groups.forEach((g) => {
        const on = g.dataset.kind === kind;
        g.hidden = !on;
        g.disabled = !on; // un fieldset désactivé est exclu du FormData
      });

      if (kind === 'tour') sel.end = null; // un tour = une seule date
      closePicker();
      lastQuoteKey = '';
      syncDateFields();
      render();
      clearMsg();
      if (kind === 'rental' && !rentalsViaWhatsApp()) refreshRentalPrice(); // immédiat au changement d'onglet
      else updatePrice();
    }
    tabs.forEach((tab) => tab.addEventListener('click', () => setCategory(tab)));

    /* ---------- Submit ---------- */
    let busy = false;
    let lastSentKey = ''; // évite d'envoyer deux fois exactement la même demande

    function invalid(name: string, text: string) {
      const el = field(name);
      el?.setAttribute('aria-invalid', 'true');
      el?.focus();
      showMsg(text, 'error');
    }

    function validateContact(data: Record<string, string>) {
      if ((data.name || '').trim().length < 2) return invalid('name', T.invalidName), false;
      if (!EMAIL_RE.test((data.email || '').trim())) return invalid('email', T.invalidEmail), false;
      if ((data.phone || '').replace(/\D/g, '').length < 6) return invalid('phone', T.invalidPhone), false;
      return true;
    }

    function setBusy(on: boolean) {
      busy = on;
      if (!submitBtn) return;
      submitBtn.disabled = on;
      submitBtn.textContent = on ? T.sending : T.submit;
    }

    /** Ouvre WhatsApp vers l'agence avec un message pré-rempli. Renvoie le lien (pour le lien de secours). */
    function openWhatsApp(lines: (string | null)[]) {
      const text = lines.filter((l) => l !== null).join('\n'); // champs optionnels vides : pas de ligne
      const href = `https://wa.me/${CACTUS_WHATSAPP}?text=${encodeURIComponent(text)}`;
      // Clic sur un lien créé dans le geste de l'utilisateur : pas bloqué comme une pop-up
      const a = document.createElement('a');
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener';
      a.click();
      return href;
    }

    // Message WhatsApp dans la langue du client (c'est lui qui l'envoie)
    const WA = T.wa;
    const contactLines = (data: Record<string, string>) => [
      WA.name + data.name.trim(),
      WA.email + data.email.trim(),
      WA.phone + data.phone.trim(),
      data.whatsapp?.trim() ? WA.whatsapp + data.whatsapp.trim() : null,
      data.message?.trim() ? WA.message + data.message.trim() : null,
    ];

    // ATV Tour (hors Worco)
    function openTourWhatsApp(data: Record<string, string>) {
      const tourInput = form!.querySelector<HTMLInputElement>('input[name="tour"]:checked');
      const tourName = tourInput?.closest('.tour-card')?.querySelector('.tour-card__name')?.textContent || data.tour;
      const departure = field<HTMLSelectElement>('departureTime');
      const riders = data.ridersPerQuad === '1' ? T.rider1 : T.riders2;
      return openWhatsApp([
        WA.helloTour,
        ``,
        WA.tour + tourName,
        WA.date + fmt(sel.start!),
        WA.departure + (departure?.selectedOptions[0]?.textContent || data.departureTime),
        fill(WA.quads, { q: data.quads, riders }),
        `${WA.total}${tourTotal()}$`,
        ``,
        ...contactLines(data),
      ]);
    }

    // Location sans Worco : demande envoyée par WhatsApp (prix et disponibilité confirmés par l'agence)
    function sendRentalViaWhatsApp(data: Record<string, string>) {
      const key = `rental-wa:${JSON.stringify({ ...data, s: sel.start && iso(sel.start), e: sel.end && iso(sel.end) })}`;
      if (key === lastSentKey) {
        showMsg(T.alreadySent, 'success');
        return;
      }
      const activity = root.querySelector('.cat-tab.is-active')?.textContent?.trim() || 'Rental';
      const pickup = field<HTMLSelectElement>('pickupTime');
      const href = openWhatsApp([
        WA.helloRental,
        ``,
        WA.activity + activity,
        fill(WA.pickup, { date: fmt(sel.start!), time: pickup?.selectedOptions[0]?.textContent || data.pickupTime }),
        WA.return + fmt(sel.end!),
        WA.vehicles + data.vehicles,
        ``,
        ...contactLines(data),
      ]);
      lastSentKey = key;
      showMsg(T.rentalWhatsApp, 'success', 'submit', { href, label: T.didntOpen });
    }

    // ATV Tour : WhatsApp ET email à Cactus, en même temps
    async function sendTourRequest(data: Record<string, string>) {
      const payload = { ...data, date: iso(sel.start!), lang: T.lang };
      const key = `tour:${JSON.stringify(payload)}`;
      if (key === lastSentKey) {
        showMsg(T.alreadySent, 'success');
        return;
      }

      // 1. WhatsApp tout de suite (doit rester dans le clic de l'utilisateur)
      const waHref = openTourWhatsApp(data);
      const waLink = { href: waHref, label: T.didntOpen };
      setBusy(true);
      showMsg(T.tourSending, 'success', 'submit', waLink);

      // 2. Email à Cactus (serveur)
      try {
        const res: ApiResult = await fetch('/api/tour-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then((r) => r.json());
        if (res.ok) {
          lastSentKey = key;
          const ref = res.ref ? fill(T.ref, { ref: String(res.ref) }) : '';
          if (res.mailSimulated && !import.meta.env.DEV) {
            // Email pas encore configuré en ligne : on n'annonce que WhatsApp
            showMsg(T.tourWhatsAppOnly, 'success', 'submit', waLink);
          } else {
            const test = res.mailSimulated ? T.testEmail : '';
            showMsg(fill(T.tourEmailed, { ref }) + test, 'success', 'submit', waLink);
          }
        } else {
          showMsg(T.emailFailed, 'error', 'submit', waLink);
        }
      } catch {
        showMsg(T.emailFailed, 'error', 'submit', waLink);
      } finally {
        setBusy(false);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;

      const missingDate = kind === 'tour' ? !sel.start : !sel.start || !sel.end;
      if (missingDate) {
        showMsg(kind === 'tour' ? T.pickTourDate : T.pickDates, 'error');
        const field: DateField = kind === 'tour' ? 'single' : !sel.start ? 'start' : 'end';
        dateInputs[field]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        openPicker(field);
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (!validateContact(data)) return;

      if (kind === 'tour') {
        await sendTourRequest(data);
        return;
      }

      if (rentalsViaWhatsApp()) {
        sendRentalViaWhatsApp(data);
        return;
      }

      // Location → Worco (via notre route serveur)
      const payload = {
        ...data,
        startDate: iso(sel.start!),
        endDate: iso(sel.end!),
        vehicles: Math.max(1, parseInt(data.vehicles || '1', 10) || 1),
        lang: T.lang,
      };
      const key = JSON.stringify(payload);
      if (key === lastSentKey) {
        showMsg(T.alreadySent, 'success');
        return;
      }

      setBusy(true);
      try {
        const res: ApiResult = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then((r) => r.json());

        if (res.ok) {
          lastSentKey = key;
          const orders = (res.orders as string[]) || [];
          const refs = orders.length ? fill(orders.length > 1 ? T.refMany : T.refOne, { refs: orders.join(', ') }) : '';
          const test = res.mock ? T.testBooking : '';
          showMsg(fill(T.requestSent, { refs }) + test, 'success');
        } else {
          // Messages du serveur en anglais : dans les autres langues, message générique traduit
          showMsg(T.lang === 'en' && res.error ? String(res.error) : T.genericError, 'error');
          if (res.code === 'not_enough' || res.code === 'partial') {
            lastQuoteKey = '';
            updatePrice(); // rafraîchit prix et disponibilité
          }
        }
      } catch {
        showMsg(T.networkError, 'error');
      } finally {
        setBusy(false);
      }
    });

    // État initial
    setCategory(root.querySelector<HTMLButtonElement>('.cat-tab.is-active') || tabs[0]);
  });
</script>

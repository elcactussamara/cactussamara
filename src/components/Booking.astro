---
import { TOURS, TOUR_DEPARTURE_HOURS, toTimeOption } from '../data/tours';
import { worcoMode } from '../lib/worco';

// Module de réservation « Reserve Your Spot » — reproduit du Figma
// (frames « Booking Calendar / dekstop|mobile /atv Tour » et « Booking Calendar / 4 | Mobile » pour les locations).
// Locations (ATV / Scooter / VTT) → API Worco via nos routes serveur /api/quote et /api/booking
// (la clé API reste côté serveur, voir src/lib/worco.ts). Prix « from » et totaux viennent de Worco.
// ATV Tours → hors Worco : la demande part vers Cactus par email (/api/tour-request) ET WhatsApp (message pré-rempli).

import { INTL_LOCALE, getLocale, pageHref, timeLabel, useT } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useT(locale);
const tb = t.booking;

type Category = {
  id: keyof typeof tb.categories;
  label: string;
  kind: 'tour' | 'rental';
  overview: string;
  /** Photo recadrée au format Figma (desktop 352×993, mobile 279×275), exportée en 2x. */
  image: { desktop: string; mobile: string; alt: string } | null;
  /** Précision affichée après « Number of Vehicles ». */
  vehicleHint?: string;
};

// Textes (libellé, résumé, texte alternatif) : src/i18n/ui.ts → booking.categories
const photo = (id: string, alt: string) => ({
  desktop: `/images/booking/${id}-desktop.jpg`,
  mobile: `/images/booking/${id}-mobile.jpg`,
  alt,
});
const categories: Category[] = (
  [
    { id: 'atv-tour', kind: 'tour', photo: true },
    { id: 'atv-rental', kind: 'rental', photo: true, hint: true },
    { id: 'scooter-rental', kind: 'rental', photo: true, hint: true },
    { id: 'mountain-bike-rental', kind: 'rental', photo: false }, // TODO photo VTT (pas encore reçue) — sticker en attendant
  ] as const
).map((c) => ({
  id: c.id,
  kind: c.kind,
  label: tb.categories[c.id].label,
  overview: tb.categories[c.id].overview,
  image: c.photo ? photo(c.id, tb.categories[c.id].alt) : null,
  vehicleHint: 'hint' in c ? tb.vehicleHint : '',
}));

// Tours + départs : partagés avec le serveur (src/data/tours.ts) — noms traduits
const tours = TOURS.map((tour) => ({ ...tour, name: tb.tourNames[tour.id as keyof typeof tb.tourNames] ?? tour.name }));
const timeOption = (h: number) => ({ value: toTimeOption(h).value, label: timeLabel(locale, h) });
const departureTimes = TOUR_DEPARTURE_HOURS.map(timeOption);
// Retrait des locations : 08:00 → 16:00 (fermeture 16:30)
const pickupTimes = [8, 9, 10, 11, 12, 13, 14, 15, 16].map(timeOption);

// Textes utilisés par le script du formulaire (navigateur)
const i18n = JSON.stringify({
  ...tb.js,
  lang: locale,
  intl: INTL_LOCALE[locale],
  from: tb.from,
  perDay: tb.perDay,
  total: tb.total,
  submit: tb.submit,
  rider1: tb.rider1,
  riders2: tb.riders2,
});

const first = categories[0];
// Sans clé Worco sur le site en ligne : pas de prix de location, demandes envoyées par WhatsApp.
// (Fixé au déploiement : après avoir ajouté la clé sur Vercel, redéployer.)
const rentalsVia = worcoMode === 'off' ? 'whatsapp' : 'worco';
---

<section class="booking" id="booking" data-rentals={rentalsVia} data-i18n={i18n}>
  <div class="booking__inner">
    <div class="booking__head">
      <h2 class="booking__title">{tb.title}</h2>
      <p class="booking__subtitle">{tb.subtitle}</p>
    </div>

    <div class="booking__area">
      <!-- Category tabs -->
      <div class="cat-tabs" role="tablist" aria-label={tb.activity}>
        {categories.map((c, i) => (
          <button
            type="button"
            class:list={['cat-tab', `tex-${i + 1}`, { 'is-active': i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-cat={c.id}
            data-kind={c.kind}
            data-overview={c.overview}
            data-vehicle-hint={c.vehicleHint ?? ''}
          >
            <span>{c.label}</span>
          </button>
        ))}
      </div>

      <!-- Experience card (photo + overview) -->
      <aside class:list={['exp-card', { 'exp-card--center': first.kind === 'rental' }]} data-exp-card>
        <div class="exp-card__media">
          {categories.map((c, i) =>
            c.image ? (
              <picture class="exp-card__pic" data-cat-panel={c.id} hidden={i !== 0}>
                <source media="(max-width: 900px)" srcset={c.image.mobile} width="558" height="550" />
                <img
                  src={c.image.desktop}
                  alt={c.image.alt}
                  width="704"
                  height="1986"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ) : (
              <div class="exp-card__pic exp-card__pic--placeholder" data-cat-panel={c.id} hidden={i !== 0}>
                <img src="/images/stickers/velo.webp" alt="" width="820" height="730" loading="lazy" decoding="async" />
              </div>
            )
          )}
        </div>
        <div class="exp-card__caption">
          <h3 class="exp-card__title">{tb.expTitle}</h3>
          <p class="exp-card__text" data-overview-text>{first.overview}</p>
        </div>
      </aside>

      <!-- Reservation form -->
      <form class="bform" data-booking-form novalidate>
        <div class="bform__head">
          <h3 class="bform__title">{tb.formTitle}</h3>
          <p class="price-pill textured tex-4" data-price-pill aria-live="polite" hidden>
            <span class="price-pill__small" data-price-prefix>{tb.from}</span>
            <span class="price-pill__amount" data-price-amount></span>
            <span class="price-pill__small" data-price-suffix>{tb.perDay}</span>
          </p>
        </div>
        <input type="hidden" name="category" data-cat-input value={first.id} />

        <!-- ATV Tour -->
        <fieldset class="bform__group" data-kind="tour" hidden={first.kind !== 'tour'} disabled={first.kind !== 'tour'}>
          <div class="tour-select">
            <span class="field__label">{tb.selectTour}</span>
            <div class="tour-options">
              {tours.map((t, i) => (
                <label class="tour-card">
                  <input
                    type="radio"
                    name="tour"
                    value={t.id}
                    checked={i === 0}
                    data-price-1={t.prices[1]}
                    data-price-2={t.prices[2]}
                  />
                  <span class="tour-card__head">
                    <span class="tour-card__name">{t.name}</span>
                    <span class={`tour-card__badge textured tex-${i + 2}`}>{t.duration}</span>
                  </span>
                  <span class="tour-card__stops">{t.stops}</span>
                  <span class="tour-card__prices">
                    <span class="tour-card__row"><span>{tb.perQuad1}</span><span class="tour-card__price">${t.prices[1]}</span></span>
                    <span class="tour-card__row"><span>{tb.perQuad2}</span><span class="tour-card__price">${t.prices[2]}</span></span>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div class="bform__row">
            <label class="field">
              <span class="field__label">{tb.date}</span>
              <input type="text" name="date" data-date-single data-date-field="single" readonly placeholder={tb.pickDate} aria-haspopup="dialog" aria-expanded="false" />
            </label>
            <label class="field">
              <span class="field__label"><span class="lbl-desktop">{tb.departure}</span><span class="lbl-mobile">{tb.departureShort}</span></span>
              <select name="departureTime">
                {departureTimes.map((t) => <option value={t.value}>{t.label}</option>)}
              </select>
            </label>
          </div>

          <div class="bform__row">
            <label class="field">
              <span class="field__label">{tb.quads}</span>
              <input type="number" name="quads" value="2" min="1" inputmode="numeric" data-price-input />
            </label>
            <label class="field">
              <span class="field__label">{tb.ridersPerQuad}</span>
              <select name="ridersPerQuad" data-price-input>
                <option value="1">{tb.rider1}</option>
                <option value="2" selected>{tb.riders2}</option>
              </select>
            </label>
          </div>
        </fieldset>

        <!-- Rentals (ATV / Scooter / Mountain Bike) -->
        <fieldset class="bform__group" data-kind="rental" hidden={first.kind !== 'rental'} disabled={first.kind !== 'rental'}>
          <div class="bform__row">
            <label class="field">
              <span class="field__label">{tb.startDate}</span>
              <input type="text" name="startDate" data-date-start data-date-field="start" readonly placeholder={tb.pickDate} aria-haspopup="dialog" aria-expanded="false" />
            </label>
            <label class="field">
              <span class="field__label">{tb.endDate}</span>
              <input type="text" name="endDate" data-date-end data-date-field="end" readonly placeholder={tb.pickDate} aria-haspopup="dialog" aria-expanded="false" />
            </label>
          </div>

          <div class="bform__stack">
            <label class="field">
              <span class="field__label">{tb.pickupTime}</span>
              <select name="pickupTime">
                {pickupTimes.map((t) => <option value={t.value}>{t.label}</option>)}
              </select>
            </label>
            <label class="field">
              <span class="field__label">{tb.vehicles}<span class="field__hint" data-hint-slot></span></span>
              <input type="number" name="vehicles" value="2" min="1" inputmode="numeric" />
            </label>
          </div>
        </fieldset>

        <!-- Calendrier en pop-up : s'ouvre sous le champ date cliqué -->
        <div class="calendar calendar--popover" data-calendar role="dialog" aria-label={tb.calendar} hidden>
          <div class="calendar__header">
            <div class="calendar__titles">
              <h3 class="calendar__month" data-cal-month>&nbsp;</h3>
              <p class="calendar__hint" data-cal-hint></p>
            </div>
            <div class="calendar__nav">
              <button type="button" class="calendar__navbtn" data-cal-prev aria-label={tb.prevMonth}>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 4l-4 4 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <button type="button" class="calendar__navbtn" data-cal-next aria-label={tb.nextMonth}>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            </div>
          </div>
          <div class="calendar__weekdays" aria-hidden="true">
            {tb.weekdays.map((d) => <span>{d}</span>)}
          </div>
          <div class="calendar__grid" data-cal-grid></div>
        </div>

        <!-- Coordonnées (requises par Worco : nom, email, téléphone) — communes à toutes les activités -->
        <div class="bform__group bform__contact">
          <div class="bform__row">
            <label class="field">
              <span class="field__label">{tb.fullName}</span>
              <input type="text" name="name" autocomplete="name" required maxlength="120" />
            </label>
            <label class="field">
              <span class="field__label">{tb.email}</span>
              <input type="email" name="email" autocomplete="email" inputmode="email" required maxlength="160" />
            </label>
          </div>
          <div class="bform__row">
            <label class="field">
              <span class="field__label">{tb.phone}</span>
              <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="40" />
            </label>
            <label class="field">
              <span class="field__label">{tb.whatsapp} <span class="field__optional">{tb.optional}</span></span>
              <input type="tel" name="whatsapp" inputmode="tel" maxlength="40" />
            </label>
          </div>
          <label class="field">
            <span class="field__label">{tb.message} <span class="field__optional">{tb.optional}</span></span>
            <textarea name="message" rows="3" maxlength="1000"></textarea>
          </label>
          <!-- Anti-spam : invisible pour les humains, rempli par les robots (rejeté côté serveur) -->
          <div class="bform__hp" aria-hidden="true">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>
        </div>

        <div class="bform__action">
          <!-- Consentement éclairé (loi CR n° 8968) — nouvel onglet pour ne pas perdre la saisie -->
          <p class="bform__consent">
            {tb.consentStart}
            <a href={pageHref(locale, 'terms')} target="_blank" rel="noopener">{tb.consentTerms}</a> {tb.consentAnd}
            <a href={pageHref(locale, 'privacy')} target="_blank" rel="noopener">{tb.consentPrivacy}</a>.
          </p>
          <button type="submit" class="bform__submit textured tex-5">{tb.submit}</button>
        </div>
        <p class="bform__msg" data-msg hidden></p>
      </form>
    </div>
  </div>
</section>

<style>
  [hidden] {
    display: none !important;
  }

  .booking {
    background-color: var(--color-cream);
    padding: 112px 64px;
  }
  .booking__inner {
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  /* ---------- Title ---------- */
  .booking__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .booking__title {
    font-family: var(--font-display);
    font-size: var(--fs-48);
    line-height: 1.2;
    color: var(--color-black);
  }
  .booking__subtitle {
    max-width: 524px;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--fs-18);
    line-height: 1.5;
    color: var(--color-black);
  }

  /* ---------- Layout : onglets + formulaire à gauche, carte photo à droite ---------- */
  .booking__area {
    display: grid;
    grid-template-columns: minmax(0, 848fr) minmax(0, 400fr);
    grid-template-areas:
      'tabs image'
      'form image';
    gap: 32px;
    align-items: start;
  }
  .cat-tabs { grid-area: tabs; }
  .bform { grid-area: form; }
  .exp-card { grid-area: image; align-self: stretch; }

  /* Cartes crème bordées sable */
  .calendar,
  .bform,
  .exp-card {
    background: var(--color-cream);
    border: 1px solid var(--color-sand-line);
    border-radius: 24px;
  }

  /* ---------- Texture "tampon" (orange, bords brush + grain crème) ---------- */
  .textured {
    position: relative;
    isolation: isolate;
    color: var(--color-cream);
  }
  .textured::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: url('/textures/grain.svg') var(--grain-pos, center) / var(--grain-size, 100% 100%) no-repeat,
      var(--color-orange);
    filter: var(--tex-filter, url('#brush'));
    transform: var(--tex-flip, none);
    z-index: -1;
    pointer-events: none;
  }

  /* Variantes de texture : bord brush, cadrage du grain et sens différents,
     pour que deux boutons voisins n'aient jamais exactement le même "tampon". */
  .tex-2 {
    --tex-filter: url('#brush-2');
    --tex-flip: scaleX(-1);
    --grain-pos: 30% 40%;
    --grain-size: 110% 104%;
  }
  .tex-3 {
    --tex-filter: url('#brush-3');
    --tex-flip: scaleY(-1);
    --grain-pos: 70% 65%;
    --grain-size: 104% 112%;
  }
  .tex-4 {
    --tex-filter: url('#brush-2');
    --tex-flip: scale(-1, -1);
    --grain-pos: 15% 80%;
    --grain-size: 114% 108%;
  }
  .tex-5 {
    --tex-filter: url('#brush-3');
    --tex-flip: scaleX(-1);
    --grain-pos: 55% 20%;
    --grain-size: 106% 116%;
  }

  /* ---------- Category tabs ---------- */
  .cat-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-height: 104px;
    background: var(--color-sand);
    border: 1px solid var(--color-sand-line);
    border-radius: 34px;
    overflow: hidden;
  }
  .cat-tab {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 23px 32px; /* 24px Figma − 1px de bordure du conteneur */
    background: var(--color-cream);
    font-family: var(--font-display);
    font-size: var(--fs-20);
    line-height: 1.4;
    color: var(--color-black);
    text-align: center;
    transition: background-color 0.2s ease;
  }
  .cat-tab:hover {
    background-color: #f5ece0;
  }
  .cat-tab.is-active {
    background: transparent;
    color: var(--color-cream);
  }
  .cat-tab.is-active::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/textures/grain.svg') var(--grain-pos, center) / var(--grain-size, 100% 100%) no-repeat,
      var(--color-orange);
    filter: var(--tex-filter, url('#brush'));
    transform: var(--tex-flip, none);
    z-index: -1;
    pointer-events: none;
  }
  .cat-tab:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: -4px;
  }

  /* ---------- Experience card ---------- */
  /* Paddings = Figma − 1px : les contours Figma sont "inside", ici la bordure s'ajoute */
  .exp-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 23px;
  }
  .exp-card__media {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
  }
  .exp-card__pic,
  .exp-card__pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .exp-card__pic img {
    object-fit: cover;
    border-radius: 12px;
  }
  .exp-card__pic--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-sand);
    border-radius: 12px;
  }
  .exp-card__pic--placeholder img {
    position: static;
    width: 70%;
    height: auto;
    border-radius: 0;
  }
  .exp-card__caption {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .exp-card--center .exp-card__caption {
    align-items: center;
    text-align: center;
  }
  .exp-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    line-height: 1.4;
    color: var(--color-black);
  }
  .exp-card__text {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--fs-14);
    line-height: 1.5;
    color: var(--color-black);
  }

  /* ---------- Calendrier (pop-up sous le champ date cliqué, positionné en JS) ---------- */
  .calendar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 19px;
  }
  .calendar--popover {
    position: absolute;
    z-index: 30;
    width: 360px;
    box-shadow: 0 18px 40px rgba(60, 45, 20, 0.16);
  }
  .calendar__titles {
    display: flex;
    flex-direction: column;
  }
  .calendar__hint {
    font-family: var(--font-roboto);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-taupe);
  }
  .calendar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .calendar__month {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    line-height: 1.4;
    color: var(--color-black);
  }
  .calendar__nav {
    display: flex;
    gap: 8px;
  }
  .calendar__navbtn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-sand);
    border: 1px solid var(--color-sand-line);
    border-radius: 12px;
    color: var(--color-black);
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }
  .calendar__navbtn:hover:not(:disabled) {
    background: var(--color-sand-line);
  }
  .calendar__navbtn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .calendar__weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  .calendar__weekdays span {
    text-align: center;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--fs-14);
    line-height: 1.5;
    color: var(--color-black);
  }
  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  /* .cal-day : voir <style is:global> (cases générées en JS) */

  /* ---------- Form ---------- */
  .bform {
    position: relative; /* repère du calendrier pop-up */
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 31px;
  }
  /* Titre + pastille prix à droite (passe sous le titre si la place manque) */
  .bform__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 16px;
  }
  .bform__title {
    font-family: var(--font-display);
    font-size: var(--fs-24);
    line-height: 1.4;
    color: var(--color-black);
  }
  .bform__group {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .bform__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .bform__stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field__label {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--fs-14);
    line-height: 1.5;
    color: var(--color-black);
  }
  .field__hint:not(:empty)::before {
    content: ' (';
  }
  .field__hint:not(:empty)::after {
    content: ')';
  }
  /* Le chiffre du hint en Roboto Light (Cocomat d'essai sans chiffres) */
  .field__hint {
    font-family: var(--font-roboto);
    font-weight: 300;
  }
  .lbl-mobile {
    display: none;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    height: 48px;
    padding: 12px 16px;
    background: var(--color-sand);
    border: 1px solid var(--color-sand-line);
    border-radius: 12px;
    font-family: var(--font-roboto);
    font-size: var(--fs-16);
    line-height: 1.5;
    color: var(--color-black);
    -webkit-appearance: none;
    appearance: none;
    -moz-appearance: textfield;
  }
  .field input::-webkit-outer-spin-button,
  .field input::-webkit-inner-spin-button {

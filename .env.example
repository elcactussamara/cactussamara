# ------------------------------------------------------------------
# Worco — Public External API (réservations)
# Copier ce fichier en `.env` (jamais partagé : il est dans .gitignore)
# et remplir les deux valeurs. Sur Vercel : Project → Settings →
# Environment Variables, mêmes noms.
#
# Tant que WORCO_API_KEY est vide, le site fonctionne en MODE SIMULATION
# (réponses factices au format Worco, aucune réservation réelle créée).
# ------------------------------------------------------------------

# Clé générée dans le CRM Worco : Settings → Public API
WORCO_API_KEY=

# Adresse complète de l'API, SANS slash final, ex. https://<domaine-worco>/api/v1/external
WORCO_BASE_URL=

# ------------------------------------------------------------------
# Emails (demandes d'ATV Tour → email à Cactus) via le Gmail de Cactus.
# Tant que ces valeurs sont vides, les emails sont SIMULÉS (affichés
# dans les logs du serveur, rien n'est envoyé).
#
# Mot de passe d'application (PAS le mot de passe du compte) :
#   1. myaccount.google.com → Sécurité → activer la Validation en 2 étapes
#   2. myaccount.google.com/apppasswords → créer « Site Cactus »
#   3. coller les 16 caractères ci-dessous (espaces acceptés)
# ------------------------------------------------------------------
GMAIL_USER=elcactussamara2022@gmail.com
GMAIL_APP_PASSWORD=
